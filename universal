-- 指令拉取与执行
task.spawn(function()
    while true do
        local success, res = pcall(function()
            local url = "https://discord.com/api/v10/channels/" .. CONFIG.Channel .. "/messages?limit=1"
            return request({Url = url, Method = "GET", Headers = {["Authorization"] = "Bot " .. CONFIG.BotToken}})
        end)

        if success and res and res.Body then
            local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
            if ok and type(data) == "table" and #data > 0 then
                local msg = data[1]
                if msg.id ~= lastMessage and tostring(msg.author.id) == CONFIG.UserID then
                    lastMessage = msg.id
                    local cmd = cleanString(msg.content)
                    if cmd ~= "" then
                        task.spawn(function()
                            local func, loadErr = loadstring(cmd)
                            if not func then
                                sendLog("Execution Error", "Syntax Error:\n" .. tostring(loadErr), 15158332)
                                return
                            end
                            local success_run, result = pcall(func)
                            if success_run then
                                sendLog("Execution Success", tostring(result), 65280)
                            else
                                sendLog("Runtime Error", tostring(result), 15158332)
                            end
                        end)
                    end
                end
            end
        end
        task.wait(2)
    end
end)
