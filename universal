local lastMessage = "0"

local function sendLog(title, content, color)
    pcall(function()
        request({
            Url = CONFIG.Webhook,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HttpService:JSONEncode({
                embeds = {{
                    title = title,
                    description = "```text\n" .. tostring(content) .. "\n```",
                    color = color or 3447003
                }}
            })
        })
    end)
end

local function cleanString(str)
    local cleaned = str:gsub("```lua", ""):gsub("```", "")
    return cleaned:match("^%s*(.-)%s*$")
end

